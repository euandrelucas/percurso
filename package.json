{
  "name": "percurso",
  "version": "0.1.0",
  "private": true,
  "description": "Percurso — acompanhamento psicológico com apoio de IA (closed beta)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "eval:prompts": "tsx --env-file=.env.local scripts/eval-prompts.mts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.mts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "smoke": "tsx --env-file=.env.local scripts/smoke.mts",
    "check:voices": "tsx --env-file=.env.local scripts/check-voices.mts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}