# ============================ Percurso — configuração ============================
# Copie para .env  (cp .env.example .env)  ou rode ./scripts/setup.sh para gerar os segredos automaticamente.

# --- Endereço público ---------------------------------------------------------------------------------------------
# Local (sem HTTPS):          SITE_ADDRESS=http://localhost        APP_URL=http://localhost
# Produção (HTTPS automático): SITE_ADDRESS=percurso.seudominio.com APP_URL=https://percurso.seudominio.com
# (aponte o DNS do domínio para o IP do servidor e libere as portas 80 e 443)
SITE_ADDRESS=http://localhost
APP_URL=http://localhost

# --- Banco de dados (PostgreSQL) ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=

# --- OpenAI -------------------------------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
# 1 = respostas simuladas, sem chamar a OpenAI (só para testar a interface)
MOCK_AI=0

# --- Admin inicial (criado no primeiro start) ---------------------------------------------------------------------------
ADMIN_EMAIL=
# mínimo 10 caracteres; se vazio/fraca, uma senha temporária é gerada e mostrada em `docker compose logs app`
ADMIN_PASSWORD=
# exige 2FA (app autenticador) para o admin em produção
ADMIN_REQUIRE_2FA=1

# --- Segredos (deixe vazio para gerar automaticamente e guardar no volume appdata) ------------------------------
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 32   — FAÇA BACKUP: sem esta chave, os dados clínicos cifrados não podem ser lidos
ENCRYPTION_KEY=

# --- Regras do beta ------------------------------------------------------------------------------------------------
SESSION_MAX_MINUTES=60
CALLS_PER_DAY=1
CHAT_MESSAGES_PER_DAY=80

# --- Portas (altere se 80/443 estiverem ocupadas) ------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
