# ============================ Percurso — configuração ============================
# Copie para .env  (cp .env.example .env)  ou rode ./scripts/setup.sh para gerar os segredos automaticamente.

# --- Endereço público ---------------------------------------------------------------------------------------------
# 1) Local (sem HTTPS):            SITE_ADDRESS=http://localhost            APP_URL=http://localhost
# 2) Produção, o Caddy faz o HTTPS: SITE_ADDRESS=percurso.seudominio.com    APP_URL=https://percurso.seudominio.com
#    (aponte o DNS para o servidor e libere 80 e 443)
# 3) Produção ATRÁS DE OUTRO PROXY que já faz o HTTPS (nginx, Cloudflare, Traefik...):
#       SITE_ADDRESS=http://percurso.seudominio.com   <- com "http://": o Caddy NÃO redireciona para HTTPS (evita o loop)
#       APP_URL=https://percurso.seudominio.com       <- o endereço que o usuário vê (cookies seguros/CSRF dependem disto)
#       HTTP_PORT=88   BIND_ADDR=127.0.0.1            <- o nginx faz proxy_pass para http://127.0.0.1:88
SITE_ADDRESS=http://localhost
APP_URL=http://localhost

# --- Banco de dados (PostgreSQL) ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=

# --- OpenAI -------------------------------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# 1 = respostas simuladas, sem chamar a OpenAI (só para testar a interface)
MOCK_AI=0

# --- Admin inicial (criado no primeiro start) ---------------------------------------------------------------------------
ADMIN_EMAIL=
# mínimo 10 caracteres; se vazio/fraca, uma senha temporária é gerada e mostrada em `docker compose logs app`
ADMIN_PASSWORD=
# exige 2FA (app autenticador) para o admin em produção
ADMIN_REQUIRE_2FA=1

# --- Segredos (deixe vazio para gerar automaticamente e guardar no volume appdata) ------------------------------
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 32   — FAÇA BACKUP: sem esta chave, os dados clínicos cifrados não podem ser lidos
ENCRYPTION_KEY=

# --- Regras do beta ------------------------------------------------------------------------------------------------
SESSION_MAX_MINUTES=60
CALLS_PER_DAY=1
CHAT_MESSAGES_PER_DAY=80

# --- Portas (altere se 80/443 estiverem ocupadas) ------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# 0.0.0.0 = aberto à internet; 127.0.0.1 = só o próprio servidor (use com nginx na frente)
BIND_ADDR=0.0.0.0

# Pausa (ms) de silêncio antes da IA responder na chamada (padrão 1300). Aumente se ela ainda cortar quem fala; diminua se estiver lenta.
# REALTIME_SILENCE_MS=1300
# Alternativa: detecção por sentido (REALTIME_VAD=semantic, REALTIME_EAGERNESS=low|medium|high)
# Alucinações/ruído: limiar de voz (0.3–0.9, padrão 0.65) e redução de ruído (near_field = fone; far_field = viva-voz/notebook)
# REALTIME_VAD_THRESHOLD=0.65
# REALTIME_NOISE=near_field
