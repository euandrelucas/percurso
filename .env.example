# --- OpenAI ---
OPENAI_API_KEY=
# Modelo de texto (chat de emergência, relatórios, análises pós-sessão)
OPENAI_CHAT_MODEL=gpt-4.1
# Modelo barato/rápido para classificação de risco e extração
OPENAI_FAST_MODEL=gpt-4.1-mini
# Modelo de voz em tempo real (WebRTC)
OPENAI_REALTIME_MODEL=gpt-realtime

# --- App ---
# Segredo longo e aleatório (openssl rand -hex 32) para assinar cookies
AUTH_SECRET=troque-isto-por-um-segredo-longo
# Admin criado automaticamente no primeiro start
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
# Caminho do banco SQLite (use um volume persistente em produção)
DATABASE_PATH=./data/percurso.db

# --- Regras do beta ---
SESSION_MAX_MINUTES=60
CALLS_PER_DAY=1
CHAT_MESSAGES_PER_DAY=80

# Responde com texto simulado, sem chamar a OpenAI (para testar a interface)
MOCK_AI=0
